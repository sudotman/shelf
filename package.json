{
  "name": "shelf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A personal library of EPUBs and PDFs, published as a static site, a JSON catalog, and an OPDS feed.",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js && node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "add": "node scripts/add.js",
    "list": "node scripts/build.js --list",
    "test": "node --test \"tests/*.test.js\"",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
